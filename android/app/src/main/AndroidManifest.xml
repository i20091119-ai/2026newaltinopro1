<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 원본 앱과 동일한 클래식 블루투스 권한 (targetSdk 30 기준 설치 시 부여) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- 클래식 블루투스 기기 검색(discovery)에는 위치 권한이 필요 (API 23~30) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- 안드로이드 12+ 에서 targetSdk를 31 이상으로 올릴 경우를 대비한 선언 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <!-- 앱 안에서 최신 버전 확인·내려받기·덮어쓰기 설치 (GitHub Releases) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 안드로이드 8+ 에서 앱이 apk 설치를 띄우려면 필요. 기기당 한 번 사용자가 허용해야 한다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <!-- allowBackup=false: 이 앱의 SharedPreferences 에는 '이 태블릿이 짝지은 로봇 MAC'이
         들어 있다. 백업/복원이나 기기 간 이전으로 그 값이 따라가면, 새 태블릿이 남의
         로봇에 붙어 버린다(12대가 서로 엉킴). 복원할 값도 아니다. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AltinoWebCtrl">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale|smallestScreenSize|screenLayout|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 내려받은 apk 를 설치 화면에 안전하게 넘기기 위한 provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
